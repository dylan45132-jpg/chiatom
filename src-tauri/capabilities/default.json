{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-rename",
    "dialog:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "store:default",
    {
      "identifier": "fs:scope",
      "allow": [
        "$TEMP/**",
        "$PICTURE/**",
        "$DOWNLOAD/**",
        "$DESKTOP/**",
        "$DOCUMENT/**",
        "$HOME/**"
      ]
    }
  ]
}